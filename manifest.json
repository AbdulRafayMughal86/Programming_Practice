{
  "manifest_version": 3,
  "name": "Local Dark Pattern Scanner",
  "version": "0.1.0",
  "description": "Proof-of-concept local TF-IDF + Logistic Regression scanner for possible dark patterns on webpages.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dark Pattern Scanner"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "classifier.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model/model.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
